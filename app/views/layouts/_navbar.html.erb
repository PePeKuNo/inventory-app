<%# Full page reload (no Turbo): Turbo only swaps <body>, but theme and language live on <html>. %>
<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand fw-semibold" do %>
      <i class="bi bi-box-seam"></i> Inventory
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="main-nav">
      <%= form_with url: search_path, method: :get, class: "d-flex flex-grow-1 my-2 my-lg-0 mx-lg-4", role: "search" do |f| %>
        <%= f.search_field :q, value: params[:q], class: "form-control", placeholder: t("nav.search") %>
      <% end %>

      <ul class="navbar-nav align-items-lg-center gap-lg-2">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-translate"></i> <%= I18n.locale.upcase %></a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><%= button_to "English", preference_path, method: :patch, params: { locale: "en" }, class: "dropdown-item", form: { data: { turbo: false } } %></li>
            <li><%= button_to "Українська", preference_path, method: :patch, params: { locale: "uk" }, class: "dropdown-item", form: { data: { turbo: false } } %></li>
          </ul>
        </li>
        <li class="nav-item">
          <% next_theme = current_theme == "dark" ? "light" : "dark" %>
          <%= button_to preference_path, method: :patch, params: { theme: next_theme }, class: "btn nav-link", title: t("nav.theme"), form: { data: { turbo: false } } do %>
            <i class="bi <%= current_theme == "dark" ? "bi-sun" : "bi-moon-stars" %>"></i>
          <% end %>
        </li>

        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> <%= current_user.name %></a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to t("nav.my_page"), user_path(current_user), class: "dropdown-item" %></li>
              <% if current_user.admin? %>
                <li><%= link_to t("nav.admin"), admin_users_path, class: "dropdown-item" %></li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li><%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item"><%= link_to t("nav.sign_in"), new_user_session_path, class: "btn btn-primary btn-sm" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

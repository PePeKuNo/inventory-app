<% stats = inventory.statistics %>
<p class="fs-5"><%= t("stats.items_count") %>: <strong><%= stats["items_count"] %></strong></p>

<div class="table-responsive col-lg-8">
  <table class="table">
    <thead>
      <tr><th><%= t("fields.name") %></th><th><%= t("stats.type") %></th><th><%= t("stats.value") %></th></tr>
    </thead>
    <tbody>
      <% inventory.custom_fields.each do |field| %>
        <tr>
          <td><%= field.name %></td>
          <td><%= field_type_label(field.type) %></td>
          <td>
            <% if field.type == "int" %>
              <%= t("stats.min") %> <%= Inventory::CustomFields.display_number(stats["#{field.key}_min"]&.round(2)) || "—" %>,
              <%= t("stats.max") %> <%= Inventory::CustomFields.display_number(stats["#{field.key}_max"]&.round(2)) || "—" %>,
              <%= t("stats.avg") %> <%= Inventory::CustomFields.display_number(stats["#{field.key}_avg"]&.round(2)) || "—" %>
            <% elsif field.type == "bool" %>
              <%= t("stats.checked") %>: <%= stats["#{field.key}_true"] %> / <%= stats["items_count"] %>
            <% else %>
              <%= t("stats.most_frequent") %>: <%= stats["#{field.key}_mode"].to_s.truncate(60).presence || "—" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

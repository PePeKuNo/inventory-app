<% writable = inventory.writable_by?(current_user) %>
<% fields = inventory.table_fields %>
<% items = inventory.items.includes(:user).order(:created_at) %>

<% if writable %>
  <%= form_with url: bulk_destroy_inventory_items_path(inventory), method: :delete, id: "items-form" do %><% end %>
<% end %>

<div data-controller="table">
  <div class="d-flex flex-wrap gap-2 mb-2">
    <% if writable %>
      <%= link_to new_inventory_item_path(inventory), class: "btn btn-sm btn-primary" do %><i class="bi bi-plus-lg"></i> <%= t("items.add") %><% end %>
      <button type="submit" form="items-form" class="btn btn-sm btn-outline-danger" disabled
              data-table-target="action" data-turbo-confirm="<%= t("actions.confirm") %>">
        <i class="bi bi-trash"></i> <%= t("actions.delete") %>
      </button>
    <% end %>
    <input type="search" class="form-control form-control-sm ms-auto" style="max-width: 16rem"
           placeholder="<%= t("table.filter") %>" data-table-target="filter" data-action="input->table#filter">
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <% if writable %>
            <th class="table-select"><input type="checkbox" class="form-check-input" data-table-target="selectAll" data-action="table#toggleAll"></th>
          <% end %>
          <th data-action="click->table#sort">ID</th>
          <% fields.each do |field| %>
            <th data-action="click->table#sort" title="<%= field.description %>"><%= field.name %></th>
          <% end %>
          <th data-action="click->table#sort"><%= t("items.created_by") %></th>
        </tr>
      </thead>
      <tbody data-table-target="body">
        <% items.each do |item| %>
          <tr data-href="<%= inventory_item_path(inventory, item) %>" data-action="click->table#open">
            <% if writable %>
              <td><input type="checkbox" class="form-check-input" name="ids[]" value="<%= item.id %>" form="items-form"
                         data-table-target="checkbox" data-action="table#updateActions"></td>
            <% end %>
            <td class="font-monospace"><%= item.custom_id %></td>
            <% fields.each do |field| %>
              <td data-value="<%= item[field.key] %>"><%= field_value(item, field) %></td>
            <% end %>
            <td><%= item.user&.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if items.empty? %><p class="text-body-secondary"><%= t("table.empty") %></p><% end %>
</div>

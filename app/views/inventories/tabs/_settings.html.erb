<%= form_with model: inventory, class: "col-lg-8" do |f| %>
  <div class="mb-3">
    <%= f.label :title, t("inventory.title"), class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, t("inventory.description"), class: "form-label" %>
    <%= f.text_area :description, rows: 6, class: "form-control font-monospace" %>
    <div class="form-text"><i class="bi bi-markdown"></i> <%= t("inventory.markdown_hint") %></div>
  </div>

  <div class="mb-3">
    <%= f.label :category_id, t("inventory.category"), class: "form-label" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: true }, class: "form-select" %>
  </div>

  <%= f.submit t("actions.save"), class: "btn btn-primary" %>
<% end %>

<hr>
<%= button_to inventory_path(inventory), method: :delete, class: "btn btn-outline-danger btn-sm",
      form: { data: { turbo_confirm: t("actions.confirm") } } do %>
  <i class="bi bi-trash"></i> <%= t("inventory.delete") %>
<% end %>

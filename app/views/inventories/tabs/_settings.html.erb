<%= form_with model: inventory, class: "col-lg-8",
      data: { controller: "autosave",
              action: "input->autosave#markDirty change->autosave#markDirty submit->autosave#submit",
              autosave_messages_value: t("autosave").to_json } do |f| %>
  <%= f.hidden_field :lock_version %>

  <div class="mb-3">
    <%= f.label :title, t("inventory.title"), class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, t("inventory.description"), class: "form-label" %>
    <%= f.text_area :description, rows: 6, class: "form-control font-monospace" %>
    <div class="form-text"><i class="bi bi-markdown"></i> <%= t("inventory.markdown_hint") %></div>
  </div>

  <div class="mb-3">
    <%= f.label :category_id, t("inventory.category"), class: "form-label" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: true }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :tag_list, t("inventory.tags"), class: "form-label" %>
    <%= f.text_field :tag_list, value: inventory.tag_list, data: { controller: "tags", tags_url_value: tags_path } %>
  </div>

  <div class="mb-3" data-controller="image-upload"
       data-image-upload-cloud-name-value="<%= ENV["CLOUDINARY_CLOUD_NAME"] %>"
       data-image-upload-preset-value="<%= ENV["CLOUDINARY_UPLOAD_PRESET"] %>">
    <label class="form-label d-block"><%= t("inventory.image") %></label>
    <%= tag.img src: inventory.image_url, class: "img-thumbnail mb-2", style: "max-height: 160px",
                hidden: inventory.image_url.blank?, alt: "", data: { image_upload_target: "preview" } %>
    <%= f.hidden_field :image_url, data: { image_upload_target: "input" } %>
    <div>
      <% if ENV["CLOUDINARY_CLOUD_NAME"].present? %>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="image-upload#open"><i class="bi bi-cloud-upload"></i> <%= t("inventory.upload") %></button>
      <% end %>
      <button type="button" class="btn btn-link btn-sm text-danger" data-action="image-upload#clear"><%= t("inventory.remove_image") %></button>
    </div>
  </div>
<% end %>

<hr>
<%= button_to inventory_path(inventory), method: :delete, class: "btn btn-outline-danger btn-sm",
      form: { data: { turbo_confirm: t("actions.confirm") } } do %>
  <i class="bi bi-trash"></i> <%= t("inventory.delete") %>
<% end %>

<h1 class="h3 mb-3"><%= t("inventory.new") %></h1>
<%= form_with model: @inventory, class: "col-md-6" do |f| %>
  <% if @inventory.errors.any? %>
    <div class="alert alert-danger"><%= @inventory.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :title, t("inventory.title"), class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true, autofocus: true %>
  </div>
  <div class="mb-3">
    <%= f.label :category_id, t("inventory.category"), class: "form-label" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: true }, class: "form-select" %>
  </div>
  <%= f.submit t("actions.create"), class: "btn btn-primary" %>
<% end %>

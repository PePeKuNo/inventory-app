<% content_for :title, @inventory.title %>
<% editable = @inventory.editable_by?(current_user) %>

<div class="d-flex flex-wrap align-items-center gap-3 mb-1">
  <h1 class="h2 mb-0"><%= @inventory.title %></h1>
  <% if editable && @tab.in?(%w[settings custom_id fields]) %>
    <span class="badge rounded-pill text-bg-light border" id="save-status"><%= t("autosave.saved") %></span>
  <% end %>
</div>
<p class="text-body-secondary small">
  <%= @inventory.category&.name %> · <%= link_to @inventory.user.name, user_path(@inventory.user) %>
  <% @inventory.tags.each do |tag| %>
    <%= link_to tag.name, search_path(tag: tag.name), class: "badge text-bg-secondary text-decoration-none" %>
  <% end %>
</p>

<ul class="nav nav-tabs mb-3">
  <% @tabs.each do |tab| %>
    <li class="nav-item">
      <%= link_to t("tabs.#{tab}"), inventory_path(@inventory, tab:), class: "nav-link #{"active" if tab == @tab}" %>
    </li>
  <% end %>
  <li class="nav-item">
    <%= link_to inventory_items_path(@inventory, format: :csv), class: "nav-link", data: { turbo: false } do %>
      <i class="bi bi-download"></i> <%= t("tabs.export") %>
    <% end %>
  </li>
</ul>

<%= render "inventories/tabs/#{@tab}", inventory: @inventory %>
